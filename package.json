{
  "name": "@local/dsh-request-cost",
  "version": "1.0.0",
  "private": true,
  "description": "Local cost meter below the composer: yuan spent per request and per session, priced from provider-reported usage.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client-locale/*.json": "./locale/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Babloved/dsh-request-cost.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "tokens",
    "yuan",
    "rub"
  ],
  "homepage": "https://github.com/Babloved/dsh-request-cost#readme"
}
